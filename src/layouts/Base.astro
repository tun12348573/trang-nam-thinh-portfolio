---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, TEXT } from '../lib/text';
import { isDemo } from '../lib/data';
import type { SiteSettings } from '../lib/types';

interface Props {
  title?: string;
  description?: string;
  settings: SiteSettings;
  ogImage?: string;
}

const { title, description, settings, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${BRAND}` : BRAND;
const site = Astro.url.origin;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.legal_name_vi,
  alternateName: BRAND,
  url: site,
  ...(settings.email && { email: settings.email }),
  ...(settings.phone && { telephone: settings.phone }),
  ...(settings.tax_code && { taxID: settings.tax_code }),
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:locale" content="vi_VN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {isDemo() && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap&subset=vietnamese"
      rel="stylesheet"
    />
    {/* Thoát "<" để nội dung cài đặt (vd. tên công ty chứa "</script>") không thoát được khỏi thẻ script. */}
    <script type="application/ld+json" set:html={JSON.stringify(orgLd).replace(/</g, '\\u003c')} />
  </head>
  <body class="min-h-screen">
    {isDemo() && (
      <div class="bg-amber-100 text-amber-900 text-center text-xs py-1.5 px-4" role="status">{TEXT.demo_banner}</div>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
