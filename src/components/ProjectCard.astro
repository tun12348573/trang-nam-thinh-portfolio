---
import MediaImage from './MediaImage.astro';
import Icon from './admin/Icon.astro';
import type { IconName } from './admin/Icon.astro';
import { coverOf } from '../lib/data';
import { CATEGORY_LABEL, PATHS, TEXT } from '../lib/text';
import type { FileUrl } from '../lib/media';
import type { Category, Project } from '../lib/types';

interface Props {
  project: Project;
  url: FileUrl;
  sizes?: string;
}
const { project: p, url, sizes = '(min-width: 768px) 30vw, 100vw' } = Astro.props;

const CATEGORY_ICON: Record<Category, IconName> = { residential: 'house', interior: 'sofa', other: 'building' };
// Thay hàng "giá / phòng ngủ" của mẫu bằng thông tin kiến trúc có dữ liệu; mục trống thì ẩn.
const meta = (
  [
    { icon: CATEGORY_ICON[p.category], label: TEXT.category, value: CATEGORY_LABEL[p.category] },
    { icon: 'ruler', label: TEXT.area, value: p.area_m2 ? `${p.area_m2} m²` : '' },
    { icon: 'mapPin', label: TEXT.location, value: p.location_vi },
    { icon: 'calendar', label: TEXT.year, value: p.year ? String(p.year) : '' },
  ] satisfies { icon: IconName; label: string; value: string }[]
).filter((m) => m.value);
---

<a href={PATHS.project(p.slug)} class="card group">
  <MediaImage media={coverOf(p)} url={url} sizes={sizes} aspect="1.06 / 1" pendingLabel={TEXT.image_pending} />
  <div class="flex flex-1 flex-col gap-4 p-4 sm:p-5">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-[15px] font-normal leading-snug">{p.title_vi}</h3>
      <Icon
        name="arrowUpRight"
        size={18}
        class="mt-0.5 text-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink"
      />
    </div>
    {meta.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-2 text-[12.5px] text-muted">
        {meta.map((m) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name={m.icon} size={15} />
            <span class="sr-only">{m.label}: </span>
            {m.value}
          </li>
        ))}
      </ul>
    )}
  </div>
</a>
