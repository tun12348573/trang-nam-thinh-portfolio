---
import { BRAND, PATHS, TEXT } from '../lib/text';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
}
const { settings: s } = Astro.props;
---

<footer class="mt-section border-t border-line">
  <div class="page grid gap-8 py-12 text-[13px] text-muted sm:grid-cols-[1fr_auto]">
    <div class="space-y-1">
      {s.legal_name_vi && <p class="text-ink">{s.legal_name_vi}</p>}
      {s.tax_code && <p>{TEXT.tax_code}: {s.tax_code}</p>}
      {s.address_vi && <p>{s.address_vi}</p>}
    </div>
    <nav aria-label="Chân trang" class="flex gap-6 sm:justify-end [&>a]:-my-3 [&>a]:inline-flex [&>a]:min-h-11 [&>a]:items-center">
      <a class="hover:text-ink" href={PATHS.projects}>{TEXT.nav_projects}</a>
    </nav>
    <p class="text-[13px] sm:col-span-2">© {new Date().getFullYear()} {BRAND}</p>
  </div>
</footer>
